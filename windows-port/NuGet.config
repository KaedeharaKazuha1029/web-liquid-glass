<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!--
      ⚠️ 这里必须是【绝对路径】。

      原来写的是相对路径 ".nuget\packages"，会导致 NuGet 抛
      「Value cannot be null. (Parameter 'path1')」而整个工具链不可用
      （连 `dotnet nuget list source` 都跑不了，不只是 restore/build）。

      原因：NuGet 对 globalPackagesFolder 的相对路径会尝试相对于
      NuGet.Config 所在目录做解析；当解析基准取不到时会传入 null，
      于是在 Path.Combine 里炸掉。绝对路径没有这个歧义。

      另外注意本目录下 NuGet.Config / nuget.config 在 Windows 上是
      同一个文件（同一个 inode），不是两个配置，不用管。
    -->
    <add key="globalPackagesFolder" value="C:\Users\1\WorkBuddy\2026-09-15-13-33-33\LiquidGlassWin\.nuget\packages" />
  </config>
</configuration>
