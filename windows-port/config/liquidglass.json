{
  // ==========================================================================
  //  LiquidGlass 配置文件
  // --------------------------------------------------------------------------
  //  位置：%APPDATA%\LiquidGlass\liquidglass.json
  //  首次运行时程序会自动生成一份等价文件，你可以直接改这份内容覆盖它。
  //
  //  本文件支持 // 注释与尾随逗号（解析时会被跳过）。
  //  但请注意：程序"另存配置"时写回的是不含注释的纯 JSON。
  //
  //  改完不需要重启：托盘菜单 →「重新载入配置」即可生效。
  // ==========================================================================

  "configVersion": 1,

  // ==========================================================================
  //  工作模式
  // --------------------------------------------------------------------------
  //    "replace"  （默认）完全隐藏系统任务栏，由本程序绘制一条液态玻璃任务栏。
  //                      高度固定、宽度随应用数量变化；每个应用图标在上、名字在下。
  //    "underlay"          保留系统任务栏，把玻璃垫在它下面（v1 行为）。
  // ==========================================================================
  "mode": "replace",

  // --------------------------------------------------------------------------
  //  替换任务栏
  // --------------------------------------------------------------------------
  "taskbarReplacement": {
    // ------------------------------------------------------------------------
    //  Z 序层级（任务栏"待在哪一层"）
    //    "desktopBottom"     默认。桌面之上、所有普通窗口之下，且【始终可见】。
    //                        做法是仅把 Z 序沉底，不改变父子关系 —— 所以不会消失。
    //    "behindDesktopIcons" 寄生到桌面壁纸所在的 WorkerW。
    //                        ⚠️ 会落到桌面图标/壁纸【之下】，看起来像"任务栏不见了"
    //                        （v2.2.0 实测踩过的坑）。只有想把它当壁纸时才用。
    //    "topMost"           始终置顶，会盖住所有普通窗口（v2.1 的行为）。
    //    "normal"            普通窗口层：不下沉也不置顶，可能被后开的窗口盖住。
    // ------------------------------------------------------------------------
    "zOrder": "desktopBottom",

    // 玻璃胶囊高度（像素）。v2.2 起按用户要求整体翻倍（58→116）。
    // 应用变多时只增长长度，高度仍恒定。
    "height": 116,

    // 每个应用占的宽度。任务栏总宽 = 固定部分 + 应用数 × 这个值。
    "itemWidth": 120,

    // 应用图标边长。
    "iconSize": 82,

    // 图标下方文字的字号（像素）。
    "labelFontSize": 19,

    // 开始按钮宽度。隐藏系统任务栏后这里是唯一可见的开始入口，建议保留。
    "startButtonWidth": 96,

    // 时钟区域宽度。
    "clockWidth": 148,

    // 快捷设置按钮宽度（点它等于按 Win+A）。点击时钟等于 Win+N。
    "quickSettingsWidth": 80,

    // 胶囊左右内边距 / 距屏幕底边的距离（v2.2 同比例翻倍）。
    "horizontalPadding": 20,
    "bottomMargin": 16,

    "showStartButton": true,
    "showClock": true,
    "showQuickSettings": true,

    // true = 底部居中（贴近原项目的悬浮导航栏）；false = 靠左。
    "centerHorizontally": true,

    // ------------------------------------------------------------------------
    //  悬停胶囊（hover capsule）—— 上游最有辨识度的交互
    //  鼠标在任务栏上移动时，一块【玻璃镜头】跟着指针滑行：
    //      宽度 = 任务栏宽度 × capsuleWidthRatio（默认 0.2，即 1/5）
    //      高度 = 任务栏高度 × capsuleHeightScale（默认 1.2，上下各凸出 10%）
    //  它是【独立的第二个玻璃元素】：有自己的折射、独立的累积预算，
    //  所以移动它不会让整条任务栏重新累积。
    //  ⚠️ 高度 1.2× 意味着任务栏会向上多占约 10% 的画布 —— 这是刻意留的溢出区，
    //     否则胶囊两端会被裁掉、退化成和任务栏一样高。
    // ------------------------------------------------------------------------
    "capsuleEnabled": true,

    // 宽度比例（上游 0.2 = 1/5）。
    "capsuleWidthRatio": 0.2,

    // 高度倍率（上游 1.2 = 上下各凸出 10%）。设为 1.0 就不凸出、也不占额外画布。
    "capsuleHeightScale": 1.2,

    // 胶囊的独立性能预算。调低只影响胶囊自己的干净度，不拖累任务栏本体。
    // 上游桌面用 4、移动端用 1；本移植默认 2（CPU 后端更贵）。
    "capsulePathsPerPixel": 2,
    "capsuleAccumulation": 16,

    // 【移动时】的路径数。胶囊一动，时间累积就被清空（包围盒变了），那一帧只剩一次采样；
    // 路径数太低时随机反射会变成肉眼可见的噪点 —— 观感就是"花"。
    // 移动时抬到 6、停下立刻回落到 2 靠累积收敛，同时保住"干净"和"省 CPU"。
    "capsuleMovingPathsPerPixel": 6,

    // 跟随指针的平滑系数：1 = 瞬时贴合，0.35 = 略带惯性的滑动。
    "capsuleFollow": 0.35,

    // 是否完全隐藏系统任务栏。
    "hideSystemTaskbar": true,

    // ------------------------------------------------------------------------
    //  是否在屏幕底部【预留工作区】，让最大化窗口在任务栏上方停住。
    //    true（默认）  任务栏【永远可见、且不遮挡任何窗口】。
    //                  预留高度 = height + bottomMargin（本机上就是 116 + 16 = 132px）。
    //    false         工作区释放为整屏，窗口延伸到底 —— 玻璃能折射窗口内容，
    //                  但当 zOrder = "desktopBottom" 时，任务栏会被最大化窗口整个盖住。
    //  仅对 zOrder = "desktopBottom" 生效（置顶模式不需要预留）。
    // ------------------------------------------------------------------------
    "reserveWorkArea": true,

    // 是否释放工作区，让最大化窗口延伸到玻璃下方。
    //
    // ⚠️ 与上面的 reserveWorkArea 互斥：预留生效时本项自动失效。
    //
    // ⚠️ 这一条的实现有个必须知道的细节：单纯隐藏任务栏窗口**不会**释放工作区，
    //    必须开启任务栏"自动隐藏"才行。本程序会先尝试不改设置的手段并实测工作区，
    //    失败才自动升级 —— 届时「设置 → 个性化 → 任务栏」里的开关会短暂变为打开，
    //    退出时精确还原（原状态记在 %LOCALAPPDATA%\LiquidGlass\session-state.json）。
    //
    //    开启 = 折射源是窗口底部的真实界面，效果最好；关闭 = 玻璃背后只剩壁纸。
    "releaseWorkArea": true,

    // 模型重扫的安全网间隔（毫秒）。窗口事件会即时触发刷新，这里只是兜底。
    "safetyRescanMs": 2500
  },

  // --------------------------------------------------------------------------
  //  接管目标（仅在 mode = "underlay" 时生效）
  // --------------------------------------------------------------------------
  "taskbar": {
    "enabled": true,

    // 玻璃相对任务栏矩形向内缩多少像素。
    // 内缩出的一圈会让玻璃看起来"浮"在任务栏上，而不是填满整条。
    // 水平 10 + 垂直 6 在 150% 缩放的 72px 任务栏上观感最接近上游的悬浮导航栏。
    "glassInsetX": 10,
    "glassInsetY": 6,

    // 圆角半径。-1 = 沿上游规则（max(1, min(半宽,半高) - 1)），
    // 在 2540×60 的玻璃上会得到完整胶囊形（半径 29）。
    // 想要方正一点的玻璃就填具体值，例如 12。
    "cornerRadius": -1,

    // 是否抹掉任务栏的原生背景。
    // 关掉它玻璃会被系统背景完全遮住 —— 除非你只想做实验，否则保持 true。
    "makeTargetTransparent": true
  },

  "secondaryTaskbars": {
    "enabled": true,
    "glassInsetX": 10,
    "glassInsetY": 6,
    "cornerRadius": -1,
    "makeTargetTransparent": true
  },

  // 开始菜单 / 搜索 / 操作中心 / 小组件这几个界面只在被打开时才存在，
  // 所以程序会按秒级重扫窗口列表，你打开它们的瞬间就会被接管。
  "startMenu": {
    "enabled": true,
    "glassInsetX": 6,
    "glassInsetY": 6,
    "cornerRadius": 42,
    "makeTargetTransparent": true
  },

  "search": {
    "enabled": false,
    "glassInsetX": 6,
    "glassInsetY": 6,
    "cornerRadius": 14,
    "makeTargetTransparent": true
  },

  "actionCenter": {
    "enabled": false,
    "glassInsetX": 6,
    "glassInsetY": 6,
    "cornerRadius": 14,
    "makeTargetTransparent": true
  },

  "widgets": {
    "enabled": false,
    "glassInsetX": 6,
    "glassInsetY": 6,
    "cornerRadius": 14,
    "makeTargetTransparent": true
  },

  "taskView": {
    "enabled": false,
    "glassInsetX": 0,
    "glassInsetY": 0,
    "cornerRadius": 0,
    "makeTargetTransparent": false
  },

  // --------------------------------------------------------------------------
  //  材质覆盖
  // --------------------------------------------------------------------------
  //  所有字段都可以省略或写成 null —— null 表示"沿用上游参考值"。
  //  上游文档明确建议：先用默认值完成视觉验收，再考虑调参。
  //
  //  常用几个的含义：
  //    tintMix            整体染色比例。默认 0.17 会把画面压暗，
  //                       亮色壁纸下显得发灰时把它调到 0 或 0.05 会通透很多。
  //    dispersionStrength 色散强度。0.22 是很克制的高级灰，
  //                       调到 0.45 会看到明确的红蓝分离（偏"光学玩具"）。
  //    frostedStrength    毛玻璃强度。对带文字的界面调高更易读。
  //    frostedBlurRadius  【重影的根治参数】雾化模糊的支撑半径（纹理像素）。
  //                       抑制周期 T 的背景结构需要约 T/2 的半径。
  //                       实测残余振幅（160px 周期）：半径24→0.91、
  //                       半径48→0.68、半径96→0.24、半径128→0.18。
  //                       调大不会增加逐像素开销（走金字塔）。
  //                       ⚠️ 别超过 2^(金字塔级数-1)，否则会夹到顶层。
  //    opticalThickness   玻璃"厚度"。对 72px 高的任务栏，1.71 已经接近上限，
  //                       再大也不会更明显（内部传播会被 rect.w 比例项主导）。
  //    edgeBandRatio      边缘带宽（相对高度）。任务栏上 0.26 已经覆盖整条，
  //                       调大只会让中心也糊掉。
  "material": {
    "reverseDisplacement": null,
    "edgeCurvature": null,
    "opticalThickness": null,
    "edgeBandRatio": null,
    "refractionVisibleRatio": null,
    "blendFeatherPx": null,
    "frostedStrength": null,
    "frostedAttenuation": null,
    "blurSpacingPx": null,
    "frostedBlurRadius": null,
    "dispersionStrength": null,
    "highlightStrength": null,
    "tintMix": null,
    "roughness": null,
    "lensMix": null
  },

  // --------------------------------------------------------------------------
  //  性能
  // --------------------------------------------------------------------------
  "performance": {
    // 每像素路径数。上游桌面参考值 4。
    // 2 大约省一半时间，噪点会略增（时间累积会补回来一部分）。
    "pathsPerPixel": 4,

    // 静止时的累积帧上限。上游参考值 48。收敛后渲染完全冻结，CPU 归零。
    "idleAccumulation": 48,

    // 鼠标划过玻璃时的累积帧上限。
    // 这是上游没有的机制 —— 上游用独立的胶囊预算实现同样的"跟手感"。
    // 调低更跟手但更噪；调高更干净但移动时会有一点点滞后。
    "movingAccumulation": 12,

    // 鼠标位置是否驱动相机射线倾斜（对应上游 uMouse 的视差效果）。
    // 想彻底静态、连鼠标划过也零开销就设为 false。
    "mouseParallax": true,

    // 渲染循环轮询间隔（毫秒）。33 ≈ 30Hz。
    // 它同时决定单帧渲染预算（预算 = 节拍 × 0.8），也就是画质调节器的目标帧时间。
    "tickIntervalMs": 33,

    // ----------------------------------------------------------------------
    //  画质档位
    // ----------------------------------------------------------------------
    //   "auto"（默认）  启动时用【真实负载】实测一次定初始档位，
    //                 之后运行时闭环按实测帧耗时动态升降档。
    //                 这是推荐值 —— 同样 8 核 CPU，插电与用电池、
    //                 集显轻薄本与台式机，实际速度能差三五倍，
    //                 只有实测才靠得住。
    //
    //   "minimal"      1 path × 12 帧 · 超采样 1.0× · 抓屏 100ms
    //   "low"          2 paths × 24 帧 · 超采样 1.0× · 抓屏 66ms   ← 上游移动端档位
    //   "balanced"     3 paths × 32 帧 · 超采样 1.0× · 抓屏 50ms
    //   "high"         4 paths × 48 帧 · 超采样 1.25× · 抓屏 33ms  ← 上游桌面参考档（默认起点）
    //   "ultra"        8 paths × 64 帧 · 超采样 1.5× · 抓屏 33ms
    //
    //   锁死某一档 = 关闭自适应。想要稳定观感（比如录屏）时有用。
    //   注意：无论哪一档，光学材质都不变 —— 折射率、色散、边缘带宽
    //   在所有档位下完全一致，变的是"工作量"而不是"像不像玻璃"。
    "qualityMode": "auto"
  },

  // --------------------------------------------------------------------------
  //  场景采样
  // --------------------------------------------------------------------------
  "scene": {
    // 折射源纹理向外扩的边距（像素）。折射最远采样到边缘外约 40px，96 很安全。
    "margin": 96,

    // 是否把玻璃层排除出屏幕捕获。
    //   开 = 渲染纯净、零闪烁，但截图（含 Win+Shift+S）不会包含玻璃效果。
    //   关 = 玻璃会出现在截图里，抓屏走"临时隐藏→抓屏→恢复"，
    //        不会采到自己（隐藏期间本窗口不在屏幕捕获范围内）。
    // v2.2 起默认 false：用户要求"截图时可以截到任务栏"。
    "excludeFromCapture": false,

    // 抓屏的最小间隔（毫秒）。0 = 自动。
    //
    // ⚠️ 这条直接决定任务栏"闪不闪"和"截图能不能稳定拍到它"：
    //    没开 excludeFromCapture 时，每次抓屏都要把任务栏【隐藏几毫秒】再恢复。
    //    频率越高，观感越像闪烁、用户截图也越容易正好拍到空档。
    //    自动档的取舍：预留工作区（默认）时玻璃背后只有壁纸、基本不动 → 15 秒兜一次；
    //    没预留（窗口延伸到玻璃下方）时背后一直在变 → 400 毫秒。
    //    想彻底不闪，把 excludeFromCapture 打开（代价：截图里也看不到玻璃）。
    "captureMinIntervalMs": 0,

    // 折射源取法：
    //   "direct"          直接采样玻璃背后的屏幕像素（上游的 1:1 忠实映射）。
    //   "extendFromAbove" 把玻璃上方最后一行未被遮挡的像素向下延伸。
    //
    // ⚠️ 在 Windows 上有个物理限制值得知道：窗口不会延伸到工作区之外，
    //    所以任务栏背后永远只是"壁纸的最下面那一条"。
    //    如果壁纸是平滑渐变，折射就没有内容可以弯折，玻璃看上去只会"变透明"。
    //    这不是缺陷，是场景频率不够。换成细节丰富的壁纸效果会立刻显现；
    //    或者在最大化窗口前用 extendFromAbove，把窗口底部的内容带到玻璃下面。
    "source": "direct"
  },

  // --------------------------------------------------------------------------
  //  自研的液态玻璃【开始菜单】
  //
  //  ⚠️ 别和上面的 startMenu 目标配置搞混：那个是"底衬模式"用来指定要贴玻璃的
  //     系统开始菜单窗口；本段是"我们自己造一块开始菜单出来"，因为它把系统菜单顶掉了。
  //
  //  为什么必须自研：Windows 11 的开始菜单是 StartMenuExperienceHost.exe 的 XAML 窗口，
  //  背景由 XAML 自绘（DesktopAcrylicBackdrop），**不是 DWM 系统背景** ——
  //  DwmSetWindowAttribute(DWMWA_SYSTEMBACKDROP_TYPE) 够不到它，外部改不动外观。
  //
  //  点任务栏左边的「开始」即可弹出；点面板外部 / 按 Esc / 再点一次「开始」都会关掉。
  // --------------------------------------------------------------------------
  "glassStartMenu": {
    // 关闭后「开始」按钮回退到用 Win 键唤起系统菜单。
    "enabled": true,

    // 每行几个应用；面板尺寸由固定应用数量自动算出来。
    "columns": 6,
    "tileWidth": 212,
    "tileHeight": 212,

    "iconSize": 44,
    "labelFontSize": 12,

    // 面板内边距与圆角半径（圆角是最终像素，内部会按超采样换算）。
    "padding": 45,
    "cornerRadius": 28,

    // 面板底边与任务栏顶边的间距。
    "gapAboveTaskbar": 10,

    // 版式（对齐 Windows 11 系统开始菜单）：
    //   顶部搜索框 → 「已固定」应用网格 → 「推荐的项目」→ 底部用户与电源。
    "searchBoxHeight": 68,
    "recommendedMax": 4,
    "recommendedHeight": 102,
    "bottomBarHeight": 90,

    // ----------------------------------------------------------------------
    //  「全部应用」区（读开始菜单 Programs 目录里的快捷方式）
    //
    //  ⚠️ allAppsPerScreen 是【一屏显示几项】，不是总量上限 ——
    //     完整列表一律全部加载，超出的部分用【滚轮】翻看。
    //
    //     这个区别很重要：以前这里叫 allAppsMax、语义是"总量上限"，
    //     于是本机 168 个快捷方式只加载了 24 个，剩下的既不显示也无法翻到，
    //     用户的原话就是"开始菜单无法查看所有应用"。
    //
    //     改成一屏的项数之后，"能看全部"和"打开要快"就不冲突了：
    //     一屏只解码 24 个图标（滚到哪儿解码到哪儿），打开耗时不受总数影响。
    // ----------------------------------------------------------------------
    "allAppsPerScreen": 24,
    "allAppsColumns": 6,
    "allAppsTileHeight": 118,
    "allAppsIconSize": 48,

    // 滚轮一格翻多少像素。118 = 正好一项的高度，滚一格走一行。
    "wheelStepPx": 118,

    // ----------------------------------------------------------------------
    //  性能 —— 这一段是"大面板会不会卡死"的关键，别随手调大
    //
    //  glassScale 是【玻璃的渲染倍率】：玻璃按面板尺寸 × 这个倍率来算，算完再放大，
    //  放大之后才画图标与文字（所以内容依然清晰）。
    //
    //  为什么必须这么做：玻璃是低频效果，耗时与像素数成正比。964×784 的面板
    //  在 1.0 倍率下要算 75 万像素，单帧 70ms 以上 —— 界面直接卡死，
    //  用户看到的就是"点了没反应"（实测日志里 Open() 阻塞 155ms，
    //  用户以为没反应就又点一下，于是菜单开了又关）。
    //  降到 0.4 只剩 12 万像素，快 6 倍。
    //
    //  调大它会更锐利但更慢；0.4~0.6 是安全区。
    // ----------------------------------------------------------------------
    "glassScale": 0.25,
    "pathsPerPixel": 2,
    "maxAccumulation": 24,

    // 打开时先算几帧再上屏（每帧都是阻塞的，别设大）。
    "warmupFrames": 4,

    // 两次点击的最小间隔（毫秒）。菜单打开会阻塞一两百毫秒，用户以为没反应就会再点一下，
    // 这个去抖防止"刚打开又被关掉"（实测两次点击只隔 9ms）。
    "clickDebounceMs": 200,

    // 底衬不透明度：**可读性参数**。调小更通透但底下的窗口会透上来和菜单文字打架，
    // 调大更清晰但更不像玻璃。0.72 是"能读 + 还有玻璃感"的平衡点。
    "scrimOpacity": 0.0,
    "scrimIsLight": true,

    // 鼠标光感：让玻璃高光跟着鼠标走（对应上游的 setPointer）。
    "mouseLight": true
  },

  // --------------------------------------------------------------------------
  //  行为
  // --------------------------------------------------------------------------
  "behavior": {
    // 退出时把系统组件还原为系统原生外观。
    // 强烈建议保持 true —— 否则退出后任务栏会停在全透明状态，像系统坏了。
    "restoreOnExit": true,

    // 前台窗口全屏时暂停渲染（打游戏 / 看全屏视频时既不挡视线也不浪费 CPU）。
    "pauseWhenFullscreen": true,

    "attachOnStartup": true,

    // 写日志到 %LOCALAPPDATA%\LiquidGlass\liquidglass.log
    "writeLogFile": true
  }
}
